{
  "name": "gh-store",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-supplier digital goods store: website, Telegram Mini App and bot on one core.",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.6"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && pnpm --filter @store/web typecheck",
    "lint": "eslint . && knip",
    "test": "vitest run",
    "db:migrate": "node --experimental-strip-types packages/db/scripts/migrate.ts",
    "db:test": "node --experimental-strip-types packages/db/scripts/test.ts",
    "setup:store": "node --experimental-strip-types scripts/setup.ts",
    "dev": "pnpm --filter @store/web run dev",
    "ship": "pnpm --filter @store/web run deploy",
    "build": "pnpm --filter @store/web run build"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "knip": "^6.41.0",
    "postgres": "^3.4.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.10"
  }
}
