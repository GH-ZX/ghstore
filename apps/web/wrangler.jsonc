// One Worker serves the website, the Mini App (/tg), the admin (/admin),
// the API (/api/*), the Telegram bot webhook (/telegram/webhook) and the
// scheduled jobs. Secrets are set with `wrangler secret put` — never here.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gh-store",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Workers Paid plan recommended: the free plan allows only 10 ms CPU per request.
  "triggers": { "crons": ["* * * * *"] },
  // Run next to the database (Supabase project region): the API makes several queries per request.
  "placement": { "region": "aws:ap-southeast-1" },
  "hyperdrive": [
    // Create with caching off (see `pnpm setup:store` for the full command):
    //   npx wrangler hyperdrive create gh-store-db --caching-disabled --connection-string="postgres://store_app.<ref>:...@<pooler-host>:5432/postgres"
    // For `wrangler dev`, set CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE to a local database.
    { "binding": "HYPERDRIVE", "id": "REPLACE_WITH_HYPERDRIVE_ID" }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "https://gh-store.me",
    "PAYMENT_METHODS": "sam,nowpayments,bep20,stars",
    // Public project URL (not a secret). Used only to check website logins.
    "SUPABASE_URL": "https://njlzgfddfnnqujaodbta.supabase.co"
  }
  // "routes": [{ "pattern": "gh-store.me", "custom_domain": true }]
}
