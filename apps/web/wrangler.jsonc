// One Worker serves the website, the Mini App (/tg), the admin (/admin),
// the API (/api/*), the Telegram bot webhook (/telegram/webhook) and the
// scheduled jobs. Secrets are set with `wrangler secret put` — never here.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Not "gh-store": that Worker is the CURRENT live site (gh-store-dev). Deploying
  // under its name would replace it. gh-store.me moves here only at switch-over.
  "name": "ghstore",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Run next to the database (Supabase, Singapore): each request makes several
  // queries, so this saves a round trip to Asia per query. Static files are still
  // served from the visitor's nearest location.
  "placement": { "region": "aws:ap-southeast-1" },
  // Works on the free plan: the web app is static files (free and unlimited), and
  // only /api and the bot webhook run code. Workers Paid ($5/month) raises limits later.
  "triggers": { "crons": ["* * * * *"] },
  // The web app, built by `pnpm build` into dist/. Unknown paths get index.html (client-side routes).
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Product pages get their own link preview (title, picture, price) from the Worker.
    "run_worker_first": ["/api/*", "/telegram/*", "/p/*", "/sitemap.xml", "/robots.txt"]
  },
  "hyperdrive": [
    // "gh-store-db": the store_app login through the Supabase session pooler, caching off.
    // (Template copies: see `pnpm setup:store` for the create command.)
    // For `wrangler dev`, set CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE to a local database.
    { "binding": "HYPERDRIVE", "id": "69571c2a712049b39ce463767a30782a" }
  ],
  "vars": {
    // While testing on workers.dev set this to that address (https://ghstore.<account>.workers.dev):
    // the API only accepts website requests from this origin. Switch to gh-store.me at switch-over.
    "PUBLIC_BASE_URL": "https://gh-store.me",
    "PAYMENT_METHODS": "sam,nowpayments,bep20,stars",
    // Website sign-in options: telegram (same wallet as the bot), email (code), google.
    // Email and Google also need Supabase Auth set up first (docs/launch-a-store.md § 6).
    "WEB_LOGIN_METHODS": "telegram,email,google",
    // Public project URL and publishable key (both are meant for browsers; not secrets).
    // Used only for website logins by email or Google.
    "SUPABASE_URL": "https://njlzgfddfnnqujaodbta.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_gtOxP1au24qFXwzVppy0vw_oFWaSIH2",
    // Where G2Bulk reports order updates (the webhook secret is appended automatically).
    "G2BULK_CALLBACK_URL": "https://gh-store.me/api/webhooks/suppliers/g2bulk"
  }
  // "routes": [{ "pattern": "gh-store.me", "custom_domain": true }]
}
