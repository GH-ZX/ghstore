{
  "name": "@store/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node client/build.mjs",
    "dev": "node client/build.mjs --dev && wrangler dev",
    "deploy": "node client/build.mjs && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json && tsc -p client/tsconfig.json"
  },
  "dependencies": {
    "@store/api": "workspace:*",
    "@store/core": "workspace:*",
    "@store/payments": "workspace:*",
    "@store/suppliers": "workspace:*",
    "@store/ui": "workspace:*",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "simple-icons": "^16.35.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.129.0"
  }
}
