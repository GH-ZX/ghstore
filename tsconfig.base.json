{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@store/core": ["./packages/core/src/index.ts"],
      "@store/suppliers": ["./packages/suppliers/src/index.ts"],
      "@store/payments": ["./packages/payments/src/index.ts"],
      "@store/api": ["./packages/api/src/index.ts"],
      "@store/ui": ["./packages/ui/src/index.ts"],
      "@store/config": ["./store.config.ts"]
    }
  }
}
