# ─────────────────────────────────────────────────────────────────────────────
# Secret NAMES only. Never commit real values.
# Production: `npx wrangler secret put NAME` (in apps/web). Local dev: copy to
# apps/web/.dev.vars (git-ignored). Generate random values with: pnpm setup:store
# ─────────────────────────────────────────────────────────────────────────────

# Core
SESSION_SECRET=            # 48+ random characters, signs login sessions
DATA_KEY=                  # 32 random bytes, base64 — encrypts delivered codes
PUBLIC_BASE_URL=           # e.g. https://gh-store.me (a var in wrangler.jsonc)

# Database (migrations and tests only; the Worker uses the Hyperdrive binding)
DATABASE_URL=              # postgres://postgres:...@db.<ref>.supabase.co:5432/postgres
TEST_DATABASE_URL=         # a throwaway database for `pnpm test`, never production

# Website login (Supabase Auth: email / Google)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=   # random, 32+ characters; registered with setWebhook
OWNER_TELEGRAM_IDS=        # comma-separated numeric ids that become owners

# Payments (enable with PAYMENT_METHODS=sam,nowpayments,bep20,stars)
SAM_API_KEY=
SAM_WEBHOOK_SECRET=
SAM_WALLET=
SAM_METHOD=shamcash        # shamcash | syriatel
SAM_CURRENCY=USD           # USD | SYP
SAM_SYP_PER_USD=           # required when SAM_CURRENCY=SYP (new pounds)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_PAY_CURRENCY=usdtbsc
BEP20_ADDRESS=             # your USDT (BSC) receiving address
BSC_RPC_URL=               # optional, defaults to a public BSC RPC
# Telegram Stars needs only TELEGRAM_BOT_TOKEN; its price per $1 is set in Admin → Settings.

# Suppliers (each is optional; see the header of packages/suppliers/src/<name>.ts)
G2BULK_API_KEY=
G2BULK_WEBHOOK_SECRET=
BATSTORE_API_KEY=
PRODSELLER_API_KEY=
FIVESIM_API_KEY=
MAXSTORE_API_KEY=
